# Copy to .env and fill in. Never commit the populated file.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Signs customer session tokens issued by the BFF. Min 32 chars.
JWT_SECRET=

# Signs admin-service tokens. Must match admin-service's JWT_SECRET. Min 64 chars
# (admin-service signs with HS512).
ADMIN_JWT_SECRET=

# Dev only: returns the password-reset token in the API response because no mail
# transport is wired up. Leave false/unset outside local development.
ALLOW_DEV_PASSWORD_RESET=false

# Razorpay — leave blank to run the payment flow in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Fulfilment (docs/commerce-architecture.md §6–§7) ─────────────────────────
# Pincode our own stock ships from. Optional; improves carrier quotes.
WAREHOUSE_PINCODE=
# Used when a product has no recorded weight (the catalogue does not store one yet).
DEFAULT_PARCEL_WEIGHT_GRAMS=500

# Carrier APIs. Leave blank and shipments with that carrier are booked manually —
# the admin console shows each integration as "not configured".
DELHIVERY_API_TOKEN=
# Staging by default; https://track.delhivery.com for production.
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
# The warehouse name registered in your Delhivery account.
DELHIVERY_PICKUP_LOCATION=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# The pickup location nickname configured in Shiprocket.
SHIPROCKET_PICKUP_LOCATION=

# Dropship partners. Only Qikink publishes an API (docs/commerce-architecture.md §8.2);
# the others are handled manually from Admin → Dropshipping. Leave these blank and
# Qikink orders wait for manual placement, labelled as such.
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# Sandbox by default; https://api.qikink.com once Qikink enables live API access for
# the account (Dashboard → Integration → Custom API). Sandbox and live do not share a
# product catalogue.
QIKINK_BASE_URL=https://sandbox.qikink.com
# 1 = order SKUs already in your Qikink "My Products" (live); 0 = sandbox test products.
QIKINK_SEARCH_FROM_MY_PRODUCTS=1
