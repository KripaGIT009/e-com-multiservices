    "@angular/platform-browser-dynamic": "18.2.0",
    "@angular/router": "18.2.0",
    "axios": "^1.18.1",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "4.21.0",
    "http-proxy-middleware": "3.0.0",
    "jsonwebtoken": "9.0.2",
